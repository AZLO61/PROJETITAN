{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "phase",
    "activePlayerId",
    "board",
    "titans"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "phase": {
      "type": "string"
    },
    "mancheNumber": {
      "type": "integer"
    },
    "activePlayerId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "board": {
      "type": "object"
    },
    "looseBlocks": {
      "type": "object"
    },
    "titans": {
      "type": "array"
    },
    "availableActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}